# npm 10.2.4 crashes while resolving vitest 4's peer set:
#
#   TypeError: Cannot read properties of null (reading 'edgesOut')
#     at #loadPeerSet (@npmcli/arborist/lib/arborist/build-ideal-tree.js:1302)
#
# It dies walking vitest's optional peers (msw, vite ^6||^7||^8) — an arborist
# bug in that npm version, not a dependency conflict in this project. Newer npm
# (>=10.9) resolves the same tree fine.
#
# This flag makes the install deterministic across npm versions. It is safe here
# because every peer-bearing dependency is version-pinned in package.json rather
# than range-matched, so there is no peer resolution left to negotiate.
legacy-peer-deps=true
