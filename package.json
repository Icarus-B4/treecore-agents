{
  "name": "treecore-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Treecore Agents desktop app — standalone fork of the Hermes Agent desktop shell with its own gateway, data dir and update repo.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/shell",
    "build": "npm run build --workspace apps/shell",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:tokens": "node scripts/token-parity.mjs",
    "check:decoupled": "node scripts/no-upstream-imports.mjs",
    "check": "npm run typecheck && npm run check:tokens && npm run check:decoupled"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "^43.4.1",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
